#:kivy 2.1.0 
<HKD>
    MDFloatLayout:
        md_bg_color: ("#FFFFFF")
        MDCard:
            size_hint: 1, 0.3
            pos_hint: {"top": 1} 
            md_bg_color: ("#979647ff")   
            radius: [25, 25, 25, 25]  
            elevation:  0   
            FloatLayout:
                MDLabel:
                    text: '"Hai, Selamat Datang"'
                    halign: "center"
                    font_size: "50sp"
                    font_name: "TTSlabs"
                    pos_hint: {"center_x": 0.25, "center_y": 0.66}
                    color: ("#FFFFFF")
                MDLabel:
                    text: "Kami akan membantumu untuk lebih cepat menghitung Ruang Hasil Kali Dalam sebuah vektor"
                    halign: "left"
                    font_size: "20sp"
                    font_name: "Monradok"
                    pos_hint: {"center_x": 0.29, "center_y": 0.36}
                    color: ("#FFFFFF")
                    size_hint_x: 0.5         
                    text_size: self.width, None 
        MDLabel:
            text: 'Apa itu Ruang Hasil Kali Dalam?'
            halign: "center"
            font_size: "25sp"
            font_name: "TTSlabs"
            pos_hint: {"center_x": 0.5, "center_y": 0.62}
            color: ("#502222ff")
        MDLabel:
            text: "Ruang Hasil Kali Dalam adalah fungsi yang mengaitkan setiap pasangan vektor di ruang vektor V (Misalkan pasangan vektor u dan vektor v, di notasikan dengan <u, v>) dengan bilangan real dan memenuhi keempat aksioma sebagai berikut:"
            font_size: "18sp"
            font_name: "Roboto"
            pos_hint: {"center_x": 0.5, "center_y": 0.5}
            color: ("#000000")
            size_hint_x: 0.7         
            text_size: self.width, None 
        Image:
            source: "kv/assets/foto/hkd.png"
            size_hint: 0.5, 0.22
            pos_hint: {"center_x": 0.5, "center_y": 0.32}
        
        MDRaisedButton:
            text: "Hitung"
            font_size: "18sp"
            font_name: "TTSlabs"
            size_hint: 0.05, 0.07
            pos_hint: {"center_x": 0.50, "center_y": 0.13}
            md_bg_color: ("#979647ff")
            on_release:
                root.manager.current = "aksioma"